// js-concepts.js

// 1. HOISTING
console.log(hoisted);
var hoisted = "I was hoisted";

sayHi();
function sayHi() { console.log("Hello!"); }

// const sayBye = () => {} — arrow functions hoist nahi hote


// 2. TYPE COERCION
console.log(1 + "2");       // "12"
console.log("5" - 2);       // 3
console.log(true + 1);      // 2
console.log(null + 1);      // 1
console.log(undefined + 1); // NaN
console.log(0 == false);    // true  — dangerous
console.log(0 === false);   // false — safe


// 3. SCOPE CHAIN
const globalVar = "global";

function outer() {
  const outerVar = "outer";
  function inner() {
    const innerVar = "inner";
    console.log(innerVar, outerVar, globalVar);
  }
  inner();
}
outer();


// 4. CLOSURE
function makeMultiplier(factor) {
  return (num) => num * factor;
}

const double = makeMultiplier(2);
const triple = makeMultiplier(3);
console.log(double(5)); // 10
console.log(triple(5)); // 15


// 5. IIFE
const result = (function () {
  const secret = 42;
  return secret * 2;
})();
console.log(result); // 84


// 6. CALL / APPLY / BIND
const person = { name: "Rohan" };

function greet(city, country) {
  return `${this.name} from ${city}, ${country}`;
}

greet.call(person, "Rajkot", "India");
greet.apply(person, ["Rajkot", "India"]);

const boundGreet = greet.bind(person, "Rajkot");
boundGreet("India");


// 7. OPTIONAL CHAINING + NULLISH COALESCING
const user = { profile: { address: null } };

console.log(user?.profile?.address?.city);
console.log(user?.settings?.theme ?? "dark");

console.log(0 ?? 100);  // 0
console.log(0 || 100);  // 100


// 8. DESTRUCTURING
const [first, second, ...rest] = [10, 20, 30, 40, 50];
console.log(first, rest);

const { name: userName = "Guest", age = 18 } = { name: "Priya", age: 22 };
console.log(userName, age);

function display({ title, views = 0 }) {
  console.log(`${title} — ${views} views`);
}
display({ title: "JS Closures", views: 1500 });


// 9. EVENT LOOP
console.log("1");
setTimeout(() => console.log("2"), 0);
Promise.resolve().then(() => console.log("3"));
console.log("4");
// Output: 1 → 4 → 3 → 2


// 10. PURE vs IMPURE
function impureAdd(arr, val) {
  arr.push(val);
  return arr;
}

function pureAdd(arr, val) {
  return [...arr, val];
}

const original = [1, 2, 3];
console.log(pureAdd(original, 4)); // [1,2,3,4]
console.log(original);             // [1,2,3]


// BONUS
const unique = [...new Set([1, 2, 2, 3, 3])];
const flat   = [[1, 2], [3, 4]].flat();
const max    = Math.max(...[4, 7, 1, 9]);
const range  = [...Array(5).keys()];
const truthy = [0, "", null, 1, "hi", false].filter(Boolean);

console.log(unique, flat, max, range, truthy);